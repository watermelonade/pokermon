* text=auto eol=lf

# Source art and audio go through Git LFS (install it: https://git-lfs.com).
# Exported pixel-art PNGs are tiny and stay in git, so diffs and previews work.
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.ase filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Except the placeholder sounds tools/make_sfx.py generates: they're small
# (~2 MB together), rebuilt from source, and CI's checkout doesn't fetch LFS
# objects, so the test that loads every sound would see pointer files. Real
# recordings that replace them should go back through LFS: see
# assets/audio/README.md.
assets/audio/sfx/*.wav -filter binary
assets/audio/music/*.wav -filter binary
*.png binary
